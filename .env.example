# MongoDB - lokaal via MongoDB Compass
MONGODB_URI=mongodb://localhost:27017/abonnementenbeheren

# NextAuth - genereer een geheim met: openssl rand -base64 32
NEXTAUTH_SECRET=vervang-dit-door-een-geheim
NEXTAUTH_URL=http://localhost:3000

# Publieke site-URL (gebruikt voor SEO: canonical, sitemap, robots, OG).
NEXT_PUBLIC_SITE_URL=https://www.abonnementenbeheren.com

# Zet op "true" zodra de iPhone-app in de App Store staat: dan zien
# bezoekers op een iPhone op de homepage een knop naar de app.
NEXT_PUBLIC_IOS_APP_LIVE=

# Google Search Console verificatietoken (plak hier na verificatie).
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# Google OAuth (optioneel). Zet NEXT_PUBLIC_GOOGLE_ENABLED op "true"
# zodra de keys gevuld zijn, dan verschijnt de Google-knop.
NEXT_PUBLIC_GOOGLE_ENABLED=false
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── Premium (betaalmodel) ────────────────────────────────────────────────
# Hoofdschakelaar. Zolang dit niet "true" is, is alles onbeperkt gratis.
PREMIUM_ENABLED=false
# Aantal abonnementen dat gratis kan (standaard 5).
FREE_SUBSCRIPTION_LIMIT=5
# Getoonde prijzen op de site (de echte prijs staat in Stripe).
NEXT_PUBLIC_PREMIUM_PRICE_MONTHLY=€ 1,99
NEXT_PUBLIC_PREMIUM_PRICE_YEARLY=€ 14,99
NEXT_PUBLIC_CONTACT_EMAIL=info@abonnementenbeheren.com

# Stripe (website). Webhook-URL: https://www.abonnementenbeheren.com/api/stripe/webhook
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_MONTHLY=
STRIPE_PRICE_YEARLY=

# Mobiele app: geheim voor app-tokens (valt terug op NEXTAUTH_SECRET).
MOBILE_JWT_SECRET=

# RevenueCat (app). Webhook-URL: https://www.abonnementenbeheren.com/api/mobile/revenuecat-webhook
REVENUECAT_REST_API_KEY=
REVENUECAT_WEBHOOK_AUTHORIZATION=
REVENUECAT_PREMIUM_ENTITLEMENT_ID=premium
