# MongoDB — lokaal via MongoDB Compass
MONGODB_URI=mongodb://localhost:27017/abonnementenbeheren

# NextAuth — genereer een geheim met: openssl rand -base64 32
NEXTAUTH_SECRET=vervang-dit-door-een-geheim
NEXTAUTH_URL=http://localhost:3000

# Google OAuth (optioneel). Zet NEXT_PUBLIC_GOOGLE_ENABLED op "true"
# zodra de keys gevuld zijn, dan verschijnt de Google-knop.
NEXT_PUBLIC_GOOGLE_ENABLED=false
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
